.coverage
.coverage.*
.pytest_cache/
__pycache__/
*.pyc
.benchmarks/

# Egg-info from local installs (any location — guards against renamed-fork drift).
**/*.egg-info/

# Virtualenvs (in the BOND suite the root .venv is shared with the package)
.venv/

# Regenerable analysis artifacts — written by scripts/, never hand-edited.
output/

# Build output the vendored copies' own builds write into vendor/.
vendor/**/build/
